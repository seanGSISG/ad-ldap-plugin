# AD LDAP MCP server — connection settings
# Copy to .env, fill in, then load into your shell:
#   set -a; source .env; set +a
# .env is gitignored; never commit real credentials.

# Domain controller hostname (or ldaps:// URI)
AD_SERVER=dc01.example.com

# LDAPS port (default 636; 3269 for Global Catalog over SSL)
AD_PORT=636

# Search base
AD_BASE_DN=DC=example,DC=com

# Service account: UPN (svc-ldap@example.com) or full DN
AD_BIND_USER=svc-ldap@example.com
AD_BIND_PASSWORD=change-me

# LDAPS is mandatory — AD_USE_SSL=false is rejected by the server.
AD_USE_SSL=true

# Path to a CA bundle for the DC's cert (optional)
#AD_CA_CERTS=/etc/ssl/certs/corp-root-ca.pem

# Set to false ONLY for a self-signed lab DC (the sanctioned relaxation)
AD_TLS_VALIDATE=true

# Paged search size (default 500)
AD_PAGE_SIZE=500

# Optional scoped search bases (default: AD_BASE_DN). Narrow user/computer
# searches to a specific OU instead of the whole domain. DN-form direct lookups
# are unaffected.
#AD_USER_SEARCH_BASE=OU=_Users,DC=example,DC=com
#AD_COMPUTER_SEARCH_BASE=OU=_Computers,DC=example,DC=com

# HTTP transport only (docker compose). The server refuses to start without a token.
MCP_BEARER_TOKEN=change-me-to-a-long-random-secret
#HTTP_HOST=0.0.0.0
#HTTP_PORT=8000
